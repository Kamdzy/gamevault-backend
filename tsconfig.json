{
  "exclude": ["node_modules"],
  "include": ["src/**/*", ".local/plugins/**/*"],
  "compilerOptions": {
    "types": ["node", "multer", "vitest/globals"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "esnext",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // TS 6 deprecates baseUrl (removed in TS 7). Kept anyway so plugin
    // imports of the form `src/modules/...` continue to resolve — every
    // Kamdzy plugin depends on this. Revisit when TS 7 lands, either by
    // rewriting plugin imports to relative paths or via a `paths` mapping.
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": false,
    "resolveJsonModule": true
  },
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", ".local"]
  }
}
